""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
" Internal helper functions.

function! ExecuteFormatter(command)
  const l:tempfile = tempname()
  silent execute 'noautocmd write ' .. l:tempfile

  " Assumes that the file to be formatted should be the last argument.
  const l:error = system(join(a:command + [l:tempfile], ' '))

  if v:shell_error
    " This error is unfortunately hidden by the |write| confirmation message.
    " Use |messages| to examine previously given messages.
    echohl ErrorMsg
    echomsg a:command[0] .. ' (' .. v:shell_error .. '): ' .. l:error
    echohl None
  else
    1,$delete_
    silent execute '1read ' .. l:tempfile
    0delete_
  endif
  call delete(l:tempfile)
  return 0
endfunction

function! GetEncoding() abort
  return &fileencoding ? &fileencoding : &encoding
endfunction

function! GetFont() abort
{{- if eq .chezmoi.os "darwin" }}
  return '{{- print .font.name ":h" .font.size ",Monaco:h" .font.size -}}'
{{- else if eq .chezmoi.os "linux" }}
  return '{{- print .font.name " " .font.size ",Monospace " .font.size }}'
{{- else }}
  return '{{- print .font.name ":h" .font.size ",Consolas:h" .font.size -}}'
{{- end }}
endfunction

function! GetMode() abort
  let l:mode = {
        \ "\<C-s>": 'S-BLOCK',
        \ "\<C-v>": 'V-BLOCK',
        \ 'R': 'REPLACE',
        \ 'S': 'S-LINE',
        \ 'V': 'V-LINE',
        \ 'c': 'COMMAND',
        \ 'i': 'INSERT',
        \ 'n': 'NORMAL',
        \ 's': 'SELECT',
        \ 't': 'TERMINAL',
        \ 'v': 'VISUAL',
        \ }
  return get(l:mode, mode(), mode())
endfunction

function! StripTrailingEmptyLines() abort
  let l:view = winsaveview()
  keeppatterns v/\_s*\S/d
  call winrestview(l:view)
endfunction

function! StripTrailingWhitespace() abort
  let l:view = winsaveview()
  keeppatterns %s/\s\+$//e
  call winrestview(l:view)
endfunction

""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
" Ensure a consistent look and feel across CUI and GUI modes.

if has('gui_running')
  set columns={{ .editor.size.x }}
  set lines={{ .editor.size.y }}

  set guioptions+=a
  set guioptions+=c
  set guioptions-=L
  set guioptions-=R
  set guioptions-=T
  set guioptions-=b
  set guioptions-=e
  set guioptions-=f
  set guioptions-=l
  set guioptions-=m
  set guioptions-=r

  " Set list of fonts in order of preference.
  let &g:guifont=substitute(&g:guifont, '^$', GetFont(), '')

  if has('win32')
    set linespace=0
    if has('directx')
      set renderoptions=type:directx
    endif
  endif

  highlight Normal guibg=Black guifg=White
else
  highlight Normal ctermbg=Black ctermfg=White

  " Support true color in terminals other than xterm (e.g. tmux).
  if &term ==# "screen-256color"
    let &t_8f = "\<Esc>[38;2;%lu;%lu;%lum"
    let &t_8b = "\<Esc>[48;2;%lu;%lu;%lum"
  endif
endif

