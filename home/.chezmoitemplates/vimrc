""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
" Custom autocommands.

function! FormatBuffer()
  const l:view = winsaveview()
  normal gggqG
  call winrestview(l:view)
endfunction

" Format the buffer in a temporary file using a |formatexpr|.
" https://vi.stackexchange.com/a/42361
function! ShellFormat()
  const l:l1 = v:lnum
  const l:l2 = (v:lnum + v:count) - 1
  const l:lines = getline(l:l1, l:l2)
  const l:tempfile = tempname()

  call writefile(l:lines, l:tempfile)

function! ShellFormat()
  " Map b:current_syntax from $VIMRUNTIME/syntax/sh.vim to shfmt:
  const l:dialect = {
        \ 'bash':  'bash',
        \ 'ksh':   'auto',
        \ 'posix': 'posix',
        \ 'sh':    'posix',
        \ }

  const l:command = [
        \ &formatprg,
        \ '-bn',
        \ '-ci',
        \ '-i=' .. &tabstop,
        \ '-ln=' .. get(l:dialect, b:current_syntax, 'auto'),
        \ '-s',
        \ '-sr',
        \ '-w',
        \ ]

  return ExecuteFormatter(l:command)
endfunction

augroup vimrc.custom
  autocmd!

  " Remove trailing whitespace on save (unless binary)
  " https://vi.stackexchange.com/a/456
  autocmd BufWritePre *
        \ if &binary == 0                    |
        \   if empty(&formatprg)             |
        \     call StripTrailingWhitespace() |
        \   else                             |
        \     call FormatBuffer()            |
        \   endif                            |
        \ endif

  autocmd BufNewFile,BufRead *.sls,.clang-format
        \ setfiletype yaml

  autocmd BufWritePost $MYVIMRC
        \ source % |
        \ redraw!  |
        \ redrawstatus!

  autocmd FileType c,cpp
        \ if executable('clang-format') |
        \   setlocal formatprg=clang-format |
        \ endif

  autocmd FileType bash,json,sh,swayconfig,vim,yaml
        \ setlocal expandtab     |
        \ setlocal softtabstop=2 |
        \ setlocal tabstop=2

  autocmd FileType bash,sh
        \ if executable('shfmt')              |
        \   setlocal formatprg=shfmt          |
        \   setlocal formatexpr=ShellFormat() |
        \ endif

  autocmd FileType vim
        \ setlocal keywordprg=:help

  autocmd FileType markdown,text
        \ setlocal linebreak      |
        \ setlocal showbreak=+++\ |
        \ setlocal textwidth=0    |
        \ setlocal wrap

  if exists(':Man') == 2
    autocmd FileType c,cpp,sh setlocal keywordprg=:Man
  endif
augroup end

