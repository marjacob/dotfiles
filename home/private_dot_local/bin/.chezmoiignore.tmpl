{{/* Set up the Code alias on Void Linux, unless it is on WSL. */}}
{{- $codeAlias := false -}}
{{- if eq .chezmoi.os "linux" -}}
{{-   if ne .chezmoi.osRelease.id "void" -}}
{{-     $codeAlias = true -}}
{{-   end -}}
{{-   if (.chezmoi.kernel.osrelease | lower | contains "microsoft") -}}
{{-     $codeAlias = false -}}
{{-   end -}}
{{- end -}}
{{- if not $codeAlias -}}
code
{{- end -}}
