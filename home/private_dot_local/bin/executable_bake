#!/bin/sh

set -o errexit
set -o nounset

readonly GIT="${GIT:-git}"
readonly MAKE="${MAKE:-make}"
readonly MKTEMP="${MKTEMP:-mktemp}"

git_version() {
  "${GIT}" describe \
    --abbrev=8 \
    --always \
    --dirty \
    --first-parent \
    --long \
    --tags \
    2> /dev/null
}

if [ "$("${GIT}" rev-parse --is-inside-work-tree)" != "true" ]; then
  exit
fi

if ! branch="$("${GIT}" symbolic-ref --short HEAD 2> /dev/null)"; then
  branch="HEAD"
fi

if ! commit="$("${GIT}" rev-parse HEAD 2> /dev/null)"; then
  commit="0000000000000000000000000000000000000000"
fi

if ! version="$(git_version)"; then
  version="00000000"
fi

if ! worktree="$("${GIT}" rev-parse --show-toplevel)"; then
  exit
fi

if preamble="$("${MKTEMP}")"; then
  trap 'rm -f -- "${preamble}"' EXIT
else
  exit
fi

cat << EOF > "${preamble}"
.SUFFIXES:

BLANK   :=
BRANCH  := ${branch}
COMMIT  := ${commit}
GIT     := ${GIT}
SPACE   := \$(BLANK) \$(BLANK)
VERSION := ${version}
EOF

"${MAKE}" \
  --directory "${worktree}" \
  --eval "include ${preamble}" \
  --no-print-directory \
  "$@"
