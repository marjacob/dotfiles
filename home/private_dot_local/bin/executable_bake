#!/bin/sh

set -o errexit
set -o nounset

readonly GIT="${GIT:-${GIT_EXECUTABLE:-${GIT_BINARY:-git}}}"
readonly MAKE="${MAKE:-make}"
readonly MKTEMP="${MKTEMP:-mktemp}"
readonly XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-${HOME}/.config}"

git_version() {
  "${GIT}" describe \
    --abbrev=8 \
    --always \
    --dirty \
    --first-parent \
    --long \
    --tags \
    2> /dev/null
}

if [ "$("${GIT}" rev-parse --is-inside-work-tree)" != "true" ]; then
  exit
fi

if ! git_branch="$("${GIT}" symbolic-ref --short HEAD 2> /dev/null)"; then
  git_branch="HEAD"
fi

if ! git_commit="$("${GIT}" rev-parse HEAD 2> /dev/null)"; then
  git_commit="0000000000000000000000000000000000000000"
fi

if ! git_user="$("${GIT}" config --get user.name)"; then
  git_user=${LOGNAME:-$(id -un)}
fi

if ! git_version="$(git_version)"; then
  git_version="00000000"
fi

if ! git_worktree="$("${GIT}" rev-parse --show-toplevel)"; then
  exit
fi

if preamble="$("${MKTEMP}")"; then
  trap 'rm -f -- "${preamble}"' EXIT
else
  exit
fi

cat << EOF > "${preamble}"
.SUFFIXES:

BLANK        :=
GIT          := ${GIT}
GIT_BRANCH   := ${git_branch}
GIT_COMMIT   := ${git_commit}
GIT_USER     := ${git_user}
GIT_VERSION  := ${git_version}
GIT_WORKTREE := ${git_worktree}
ORIGIN       := ${PWD}
PREAMBLE     := ${preamble}
SPACE        := \$(BLANK) \$(BLANK)

# Example: \$(call path.parent,/foo/bar/baz)
path.parent = \$(patsubst %/,%,\$(dir \$(1)))

# Example: \$(call path.stem,/foo/bar.baz)
path.stem = \$(notdir \$(basename \$(1)))

# Example: \$(call path.walk,src,*.c)
path.walk = \$(sort\\
 \$(wildcard \$(1)\$(2))\\
 \$(foreach directory,\\
   \$(wildcard \$(1)*),\\
   \$(call path.walk,\$(directory)/,\$(2))\\
  )\\
)

-include ${XDG_CONFIG_HOME}/bake/preamble.mk
-include ${HOME}/.bake.mk
-include ${git_worktree}/mk/bake.mk

ifneq (${git_user},)
-include ${git_worktree}/mk/user/${git_user}.mk
endif
EOF

"${MAKE}" \
  --directory "${git_worktree}" \
  --eval "include ${preamble}" \
  --no-print-directory \
  "$@"
