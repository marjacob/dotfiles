{{- /* vim: set ft=sh: */ -}}

import() {
  if [ -f "${1}" ]; then
    . "${1}"
  fi
}

search() {
  if [ -d "${1}" ]; then
    export PATH=${1}:${PATH}
  fi
}

export BROWSER=firefox
export CC=clang
export CXX=clang++
export EDITOR=vim
export GOPATH=${HOME}/.go
export LESS=R
export MANSECT=2:3:1:n:l:8:0:5:4:9:6:7
export PREFIX=${HOME}/.local
export PYTHONDONTWRITEBYTECODE=1
{{- if eq .chezmoi.osRelease.id "void" }}
export SVDIR=${HOME}/.local/var/service
{{- end }}
export VISUAL=${EDITOR}

for package in "${HOME}/.opt"/*/; do
  search "${package}bin"
done

search "${GOPATH}/bin"
search "${HOME}/.cargo/bin"
search "${HOME}/.local/bin"
search "/opt/bin"

import "${HOME}/.cargo/env"
import "${HOME}/.profile.local"
