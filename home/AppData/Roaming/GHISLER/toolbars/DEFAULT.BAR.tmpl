  (dict "icon" "wcmicons.dll,45"
        "cmd"  "cm_CopyFullNamesToClip")
  (dict)
  (dict "icon" "%$Windows%\\explorer.exe"
        "cmd"  "em_explorer"
        "menu" "Windows Explorer")
  (dict "icon" "notepad.exe"
        "cmd"  "notepad.exe"
        "menu" "Notepad")
-}}

{{- $i := 0 -}}
{{- $au3info := "Au3Info" -}}
{{- if eq .chezmoi.arch "amd64" -}}
{{-   $au3info = printf "%s_x64.exe" $au3info -}}
{{- else -}}
{{-   $au3info = printf "%s.exe" $au3info -}}
{{- end -}}
{{- $au3info = lookPath $au3info -}}
{{- if $au3info -}}
{{-   $buttons = append $buttons
	(dict "icon" $au3info
	      "cmd"  $au3info
	      "path" "%$UserProfile%\\"
	      "menu" "Au3Info") -}}
{{- end -}}

[Buttonbar]
Buttoncount={{- len $buttons }}
{{- range $button := $buttons }}
{{-   $i = (add1 $i) }}
{{-   if $button }}
button{{- $i -}}={{ $button.icon }}
cmd{{- $i -}}={{ $button.cmd }}
{{-     if (index $button "path") }}
path{{- $i -}}={{ $button.path }}
{{-     end }}
{{-     if (index $button "menu") }}
menu{{- $i -}}={{ $button.menu }}
{{-     end }}
{{-   else }}
button{{- $i -}}=
{{-   end }}
{{- end }}
