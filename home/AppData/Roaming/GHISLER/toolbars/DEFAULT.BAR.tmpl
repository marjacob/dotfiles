        "cmd"  "cm_srcshort")
  (dict "icon" "wcmicons.dll,4"
        "cmd"  "cm_srclong")
  (dict "icon" "wcmicons.dll,26"
        "cmd"  "cm_SrcThumbs")
  (dict "icon" "wcmicons.dll,51"
        "cmd"  "cm_SwitchSeparateTree")
  (dict)
  (dict "icon" "wcmicons.dll,50"
        "cmd"  "cm_DirBranch")
  (dict)
  (dict "icon" "wcmicons.dll,11"
        "cmd"  "cm_ExchangeSelection")
  (dict)
  (dict "icon" "wcmicons.dll,18"
        "cmd"  "cm_GotoPreviousDir")
  (dict "icon" "wcmicons.dll,19"
        "cmd"  "cm_GotoNextDir")
  (dict)
  (dict "icon" "wcmicons.dll,30"
