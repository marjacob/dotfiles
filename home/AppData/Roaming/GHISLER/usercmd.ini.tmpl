{{- /* vim: set ft=dosini: */ -}}

[em_baregrep]
button=BareGrepPro.exe
cmd=BareGrepPro.exe
menu=Grep in current directory
param=--directory "%P"

[em_baretail]
button=BareTailPro.exe
cmd=BareTailPro.exe
menu=Tail selected files
param=%P%S

[em_certutil_decode]
button=%$System%\certutil.exe
cmd=%$System%\certutil.exe
menu=Decode Base64
param=-v -decode %P%S "%P%O"

[em_certutil_encode]
button=%$System%\certutil.exe
cmd=%$System%\certutil.exe
menu=Encode Base64
param=-v -encode %P%S %P%S.base64

[em_exeinfo]
button=exeinfope.exe
cmd=exeinfope.exe
menu=Exeinfo PE
param=%P%S

[em_explorer]
button=%$Windows%\explorer.exe
cmd=%$Windows%\explorer.exe
menu=Windows Explorer
param=/select,%P%S

[em_hiew]
button=%$ComSpec%
cmd=%$UserProgramFiles%\Hiew\hiew.exe
menu=Hacker's view
param=%P%S

[em_innounp]
button=%$ComSpec%
cmd=innounp.exe
menu=Inno Setup Unpacker
param=-x -m -d"%O" -y %P%S

[em_mpv]
button=%$ComSpec%
cmd=%$UserProgramFiles%\mpv\mpv.exe
menu=mpv
param=%P%S

[em_reshacker]
button=%$UserProgramFiles%\Resource Hacker\ResourceHacker.exe
cmd=%$UserProgramFiles%\Resource Hacker\ResourceHacker.exe
menu=Resource Hacker
param=%P%S

[em_sumatra]
button=SumatraPDF.exe
cmd=SumatraPDF.exe
menu=Sumatra PDF

[em_upx_pack]
button=%$System%\zipfldr.dll
cmd=%$UserProgramFiles%\UPX\upx.exe
menu=Compress executable
param=--best %P%S

[em_upx_unpack]
button=%$System%\zipfldr.dll
cmd=%$UserProgramFiles%\UPX\upx.exe
menu=Decompress executable
param=-d %P%S
