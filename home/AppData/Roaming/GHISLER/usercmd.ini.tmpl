{{- /* vim: set ft=dosini: */ -}}

[em_baregrep]
{{- with $default := "%$UserProgramFiles%\\BareGrepPro\\BareGrepPro.exe" }}
{{-   with $program := (default $default (lookPath "BareGrepPro.exe")) }}
button={{ $program }}
cmd={{ $program }}
{{-   end }}
{{- end }}
menu=Grep in current directory
param=--directory "%P"

[em_baretail]
{{- with $default := "%$UserProgramFiles%\\BareTailPro\\BareTailPro.exe" }}
{{-   with $program := (default $default (lookPath "BareTailPro.exe")) }}
button={{ $program }}
cmd={{ $program }}
{{-   end }}
{{- end }}
menu=Tail selected files
param=%P%S

[em_certutil_decode]
button=%$System%\certutil.exe
cmd=%$System%\certutil.exe
menu=Decode Base64
param=-v -decode %P%S "%P%O"

[em_certutil_encode]
button=%$System%\certutil.exe
cmd=%$System%\certutil.exe
menu=Encode Base64
param=-v -encode %P%S %P%S.base64

[em_exeinfo]
{{- with $default := "%$UserProgramFiles%\\ExeinfoPe\\exeinfope.exe" }}
{{-   with $program := (default $default (lookPath "exeinfope.exe")) }}
button={{ $program }}
cmd={{ $program }}
{{-   end }}
{{- end }}
menu=Exeinfo PE
param=%P%S

[em_explorer]
button=%$Windows%\explorer.exe
cmd=%$Windows%\explorer.exe
menu=Windows Explorer
param=/select,%P%S

{{- with $hexEditors := tuple
  (dict "icon" "%$ComSpec%"
        "name" "Hacker's View"
        "home" (printf "%s\\Programs\\Hiew" (env "LocalAppData"))
        "exec" "hiew.exe")
  (dict "name" "010 Editor"
        "home" (printf "%s\\010 Editor" (env "ProgramFiles"))
        "exec" "010Editor.exe") -}}
{{- "" }}
{{-   range $editor := $hexEditors }}
{{-     with $defaultPath := printf "%s\\%s" $editor.home $editor.exec }}
{{-       with $programPath := (default $defaultPath (lookPath $editor.exec)) }}
{{-         if (lookPath $programPath) }}

[em_hex]
{{-           if index $editor "icon" }}
button={{ $editor.icon }}
{{-           end }}
cmd={{ $programPath }}
menu={{ $editor.name }}
param="%P%S"
path=%P
{{-           break }}
{{-         end }}
{{-       end }}
{{-     end }}
{{-   end }}
{{- end }}

[em_innounp]
{{- with $default := "%$UserProgramFiles%\\Innounp\\innounp.exe" }}
{{-   with $program := (default $default (lookPath "innounp.exe")) }}
button=%$ComSpec%
cmd={{ $program }}
{{-   end }}
{{- end }}
menu=Inno Setup Unpacker
param=-x -m -d"%O" -y %P%S

