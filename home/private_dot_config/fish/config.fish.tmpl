{{- /* vim: set ft=fish: */ -}}

set -gx BROWSER firefox
set -gx CC clang
set -gx CXX clang++
set -gx EDITOR vim
set -gx GOPATH {$HOME}/.go
set -gx LESS R
set -gx MANSECT 2:3:1:n:l:8:0:5:4:9:6:7
set -gx PREFIX {$HOME}/.local
set -gx PYTHONDONTWRITEBYTECODE 1
set -gx RUBYOPT "-E utf-8:utf-8"
{{- if and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "void") }}
set -gx SVDIR {$HOME}/.local/var/service
{{- end }}
set -gx VISUAL {$EDITOR}

{{- if eq .chezmoi.os "darwin" }}

if test -x /opt/homebrew/bin/brew
    eval (/opt/homebrew/bin/brew shellenv)
end
{{- end }}

for package in {$HOME}/.opt/*
    if test -d {$package}/bin
        set -gx PATH {$package}/bin {$PATH}
    end
end

fish_add_path {$GOPATH}/bin
fish_add_path {$HOME}/.cargo/bin
fish_add_path {$HOME}/.lmstudio/bin
fish_add_path {$HOME}/.local/bin
{{- if eq .chezmoi.os "darwin" }}
fish_add_path /Applications/010 Editor.app/Contents/CmdLine
fish_add_path /opt/homebrew/opt/llvm/bin
{{- end }}
fish_add_path /opt/bin

{{  if not (lookPath "bat") }}
{{-  $bat := lookPath "batcat" }}
{{-  if not $bat }}
{{-    $bat = "cat" }}
{{-  end }}
{{-  printf "alias bat=%q\n" $bat }}
{{- end }}

{{- $code := lookPath "code-oss" }}
{{- if $code }}
{{-   printf "alias code=%q\n" $code }}
{{- end }}

{{- $lsd  := lookPath "lsd" }}
{{- if $lsd }}
{{-   printf "alias ls=%q\n" $lsd }}
{{-   printf "alias tree=%q\n" (printf "%s --tree" $lsd) }}
{{- end }}

if test -r {$HOME}/.config.fish
    source {$HOME}/.config.fish
end
