# vim: ft=swayconfig:
# man 5 sway

set $font_sway {{ print "pango:" .font.name " Regular " .font.size | quote }}

# xev -event keyboard
# xmodmap -pm
set $mod Mod4

set $left h
set $right l
set $up k
set $down j

set $lockscreen ~/.config/sway/scripts/lock
set $menu fuzzel
set $terminal foot
set $wallpaper ~/.wallpaper.jpg

font $font_sway

include /etc/sway/config.d/*
include config.d/*.conf

