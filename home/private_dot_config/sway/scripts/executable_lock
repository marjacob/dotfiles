#!/bin/bash
set -euo pipefail
IFS=$'\n\t'

umask 077

declare -r image=$(mktemp -t swaylock-XXXXXXXX.jpg)
declare -a background=()

trap 'rm -f -- "${image}"' EXIT

# A display that is powered off never delivers a frame to capture.
displays_on() {
  timeout 2 swaymsg -t get_outputs -r |
    jq -e 'all(.[] | select(.active); .power)' > /dev/null
}

# Use the wallpaper as a fallback when blurring fails or times out.
if [[ -r "${HOME}/.wallpaper.jpg" ]]; then
  background=(--image "${HOME}/.wallpaper.jpg")
fi

# Blurring is cosmetic and must not delay or prevent locking.
if displays_on; then
  if timeout 2 grim -t jpeg -q 1 "${image}" &&
    timeout 2 ffmpeg \
      -filter_complex "boxblur=luma_radius=20:luma_power=2" \
      -hide_banner \
      -i "${image}" \
      -loglevel error \
      -y "${image}"; then
    background=(--image "${image}")
  fi
fi

swaylock \
  --color 000000 \
  --daemonize \
  --hide-keyboard-layout \
  --ignore-empty-password \
  --indicator-radius 96 \
  --indicator-thickness 32 \
  --line-uses-inside \
  --show-failed-attempts \
  "${background[@]}"
