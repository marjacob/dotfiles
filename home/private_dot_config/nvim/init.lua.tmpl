-- LSP (native)

local lsp = vim.api.nvim_create_augroup("vimrc.lsp", { clear = true })

vim.api.nvim_create_autocmd("LspAttach", {
  group = lsp,
  callback = function(args)
    local function bmap(mode, lhs, rhs)
      vim.keymap.set(mode, lhs, rhs, { buffer = args.buf, silent = true })
    end

    bmap("n", "gd", vim.lsp.buf.definition)
    bmap("n", "gD", vim.lsp.buf.declaration)
    bmap("n", "gi", vim.lsp.buf.implementation)
    bmap("n", "gr", vim.lsp.buf.references)
    bmap("n", "K", vim.lsp.buf.hover)
    bmap("n", "<C-K>", vim.lsp.buf.signature_help)
    bmap("n", "<Leader>r", vim.lsp.buf.rename)
    bmap("n", "<Leader>a", vim.lsp.buf.code_action)
    bmap("n", "<Leader>f", function()
      vim.lsp.buf.format({ async = true })
    end)
    bmap("n", "[d", function()
      vim.diagnostic.jump({ count = -1 })
    end)
    bmap("n", "]d", function()
      vim.diagnostic.jump({ count = 1 })
    end)
    bmap("n", "<Leader>d", vim.diagnostic.open_float)

    if vim.lsp.completion and vim.lsp.completion.enable then
      vim.lsp.completion.enable(true, args.data.client_id, args.buf, {
        autotrigger = true,
      })
    end

    -- Auto-trigger signature help on trigger characters (e.g. `(` and `,`).
    vim.api.nvim_create_autocmd("InsertCharPre", {
      buffer = args.buf,
      callback = function()
        for _, client in ipairs(vim.lsp.get_clients({ bufnr = 0 })) do
          local triggers = vim.tbl_get(
            client,
            "server_capabilities",
            "signatureHelpProvider",
            "triggerCharacters"
          ) or {}
          if vim.tbl_contains(triggers, vim.v.char) then
            vim.defer_fn(vim.lsp.buf.signature_help, 0)
            return
          end
        end
      end,
    })

    -- Auto-trigger completion when typing word characters.
    vim.api.nvim_create_autocmd("InsertCharPre", {
      buffer = args.buf,
      callback = function()
        if vim.fn.pumvisible() == 1 then
          return
        end
        if vim.v.char:match("[%w_]") then
          vim.schedule(function()
            if vim.fn.pumvisible() == 0 and vim.fn.mode() == "i" then
              local keys =
                vim.api.nvim_replace_termcodes("<C-X><C-O>", true, true, true)
              vim.api.nvim_feedkeys(keys, "n", false)
            end
          end)
        end
      end,
    })
  end,
})

local function make_server(filetypes, cmd, root_markers)
  if vim.fn.executable(cmd[1]) == 1 then
    vim.api.nvim_create_autocmd("FileType", {
      group = lsp,
      pattern = filetypes,
      callback = function(args)
        vim.lsp.start({
          name = cmd[1],
          cmd = cmd,
          root_dir = vim.fs.root(args.buf, root_markers) or vim.fn.getcwd(),
        })
      end,
    })
  end
end

make_server(
  -- C/C++
  { "c", "cpp" },
  { "clangd" },
  { ".clangd", "compile_commands.json", ".git" }
)

make_server(
  -- Go
  { "go" },
  { "gopls" },
  { "go.mod", ".git" }
)

make_server(
  -- Lua
  { "lua" },
  { "lua-language-server" },
  { ".luarc.json", ".git" }
)

make_server(
