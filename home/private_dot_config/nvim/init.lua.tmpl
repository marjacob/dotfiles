-- Buffer switcher

vim.keymap.set("n", "<C-P>", function()
  local buffers = {}
  for _, b in ipairs(vim.api.nvim_list_bufs()) do
    if vim.api.nvim_buf_is_loaded(b) and vim.bo[b].buflisted then
      local name = vim.api.nvim_buf_get_name(b)
      if name == "" then
        name = string.format("[Buffer #%d]", b)
      end
      table.insert(buffers, { bufnr = b, name = name })
    end
  end
  if #buffers < 2 then
    return
  end
  vim.ui.select(buffers, {
    prompt = "Switch buffer:",
    format_item = function(item)
      local marker = item.bufnr == vim.api.nvim_get_current_buf() and "* "
        or "  "
      return marker .. item.name
    end,
  }, function(choice)
    if choice then
      vim.api.nvim_set_current_buf(choice.bufnr)
    end
  end)
end, { silent = true })

--------------------------------------------------------------------------------
-- Source/header switcher (LSP-first, manual fallback)

local header_by_lang = {
  c = { "h" },
  cpp = { "h++", "hh", "hp", "hpp", "hxx", "h" },
}
local source_by_lang = {
  c = { "c" },
  cpp = { "c++", "cc", "cpp", "cxx", "c" },
}

local function switch_source_header()
  if vim.lsp.get_clients({ bufnr = 0, name = "clangd" })[1] then
    vim.lsp.buf_request(
      0,
      ---@diagnostic disable-next-line: param-type-mismatch
      "textDocument/switchSourceHeader",
      { uri = vim.uri_from_bufnr(0) },
      function(err, result)
        if not err and result then
          vim.cmd("edit " .. vim.uri_to_fname(result))
          return
        end
      end
    )
    return
  end

  local basename = vim.fn.expand("%<")
  local extension = vim.fn.expand("%:e")
  local filetype = vim.bo.filetype
  local candidates = vim.tbl_contains(header_by_lang[filetype] or {}, extension)
      and source_by_lang[filetype]
    or header_by_lang[filetype]
  local directory = vim.fn.fnamemodify(vim.fn.expand("%:p:h"), ":p")

  for _, candidate in ipairs(candidates or {}) do
    local path = directory .. basename .. "." .. candidate
    if vim.fn.filereadable(path) == 1 then
      vim.cmd("edit " .. vim.fn.fnameescape(path))
      return
    end
  end
end

