-- Statusline

vim.opt.statusline = table.concat({
  -- Highlighted mode indicator.
  "%#WildMenu#",
  " %{v:lua.get_mode()} ",
  "%*",

  -- Paste indicator, shown only when 'paste' is set.
  "%{&paste?' PASTE':''} ",

  -- Current buffer, file name, and modified state.
  "%n: %<%F %m ",

  -- Separator for the left and right segments.
  "%=",

  -- Current byte under the cursor and file format.
  "0x%02.B | %{&ff} ",

  -- File encoding, shown only when set.
  "%{empty(v:lua.get_encoding())?'':'| '.v:lua.get_encoding().' '}",

  -- File type, shown only when set.
  "%{empty(&ft)?'':'| '.&ft.' '}",

  -- Highlighted cursor position.
  "%#WildMenu#",
  " %p%% %l:%c ",
  "%*",
})

