--------------------------------------------------------------------------------
-- Helper functions

function _G.get_encoding()
  return vim.bo.fileencoding ~= "" and vim.bo.fileencoding or vim.o.encoding
end

function _G.get_mode()
  local modes = {
    ["\22"] = "V-BLOCK",
    ["\19"] = "S-BLOCK",
    R = "REPLACE",
    S = "S-LINE",
    V = "V-LINE",
    c = "COMMAND",
    i = "INSERT",
    n = "NORMAL",
    s = "SELECT",
    t = "TERMINAL",
    v = "VISUAL",
  }
  return modes[vim.fn.mode()] or vim.fn.mode()
end

local function strip_trailing_whitespace()
  local view = vim.fn.winsaveview()
  vim.cmd([[keeppatterns %s/\s\+$//e]])
  vim.fn.winrestview(view)
end

local function format_buffer()
  local view = vim.fn.winsaveview()
  vim.cmd.normal({ "gggqG", bang = true })
  vim.fn.winrestview(view)
end

local format_error_group =
  vim.api.nvim_create_augroup("vimrc.formatexpr", { clear = true })

local function on_buf_write_post()
  vim.api.nvim_clear_autocmds({ group = format_error_group })
  local msg = vim.b.formatexpr_message
  if msg and msg ~= "" then
    vim.b.formatexpr_message = nil
    vim.api.nvim_echo({ { msg, "ErrorMsg" } }, true, {})
  end
end

function _G.format_expression(cmd)
  local tmp = vim.fn.tempname()
  vim.cmd("silent noautocmd write " .. vim.fn.fnameescape(tmp))
  local full = table.concat(cmd, " ") .. " " .. vim.fn.shellescape(tmp)
  local err = vim.fn.system(full)

  if vim.v.shell_error ~= 0 then
    vim.b.formatexpr_message =
      string.format("%s (%d): %s", cmd[1], vim.v.shell_error, err)
    vim.api.nvim_create_autocmd("BufWritePost", {
      group = format_error_group,
      buffer = 0,
      callback = on_buf_write_post,
      once = true,
    })
  else
    vim.api.nvim_buf_set_lines(0, 0, -1, false, vim.fn.readfile(tmp))
  end
  vim.fn.delete(tmp)
  return 0
end

local g_formatters = {}

local function set_formatter(name, default)
  local formatter = g_formatters[name] or vim.env[name] or default
  if vim.fn.executable(formatter) == 1 then
    vim.bo.formatprg = formatter
    g_formatters[name] = formatter
    return true
  end
  return false
end

