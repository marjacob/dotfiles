/* Void's example stylesheet recoloured in Gruvbox Dark to match Zed. */
@import url("file:///etc/xdg/waybar/style.css");

window#waybar {
	background-color: #282828;
	border-bottom: 3px solid #3c3836;
	color: #ebdbb2;
}

#workspaces button,
#window {
	color: #ebdbb2;
}

#workspaces button.focused,
#workspaces button.active,
#mode {
	background-color: #3c3836;
	box-shadow: inset 0 -3px #fabd2f;
}

#workspaces button.urgent {
	background-color: #fb4934;
}

/* Void gives every module and several states a block so all are cleared. */
#clock,
#battery,
#battery.charging,
#battery.plugged,
#cpu,
#memory,
#disk,
#temperature,
#backlight,
#network,
#pulseaudio,
#pulseaudio.muted,
#wireplumber,
#tray,
#idle_inhibitor,
#idle_inhibitor.activated,
#power-profiles-daemon,
#power-profiles-daemon.performance,
#power-profiles-daemon.balanced,
#power-profiles-daemon.power-saver,
#keyboard-state,
#mpris,
#custom-power {
	background: transparent;
	color: #ebdbb2;
}

#pulseaudio:hover,
#keyboard-state > label.locked {
	background-color: #3c3836;
}

#pulseaudio.muted {
	color: #928374;
}

#idle_inhibitor.activated {
	color: #fabd2f;
}

/* Warnings are the only modules that keep a block. */
#network.disconnected,
#temperature.critical,
#battery.critical:not(.charging) {
	background-color: #fb4934;
	color: #282828;
}

/* The vertical margin keeps the separators short of the bar edges. */
.modules-right > widget:not(:first-child) > * {
	border-left: 1px solid #504945;
	margin: 3px 0;
}

/* Void sets a margin here that would otherwise win over the separator rule. */
#keyboard-state {
	margin: 3px 0;
}

/* Void leaves the power button without the padding the other modules get. */
#custom-power {
	padding: 0 10px;
}
