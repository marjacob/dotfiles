// Void's example configuration with a power menu that works without systemd.
{
	"include": ["/etc/xdg/waybar/config.jsonc"],

	// The example's list without mpd and sway/language but with mpris.
	"modules-right": [
		"mpris",
		"idle_inhibitor",
		"pulseaudio",
		"network",
		"power-profiles-daemon",
		"cpu",
		"memory",
		"temperature",
		"backlight",
		"keyboard-state",
		"battery",
		"battery#bat2",
		"clock",
		"tray",
		"custom/power"
	],

	// Hidden while no player runs. Click to play or pause.
	"mpris": {
		"format": "{status_icon} {dynamic}",
		"dynamic-len": 40,
		"status-icons": {
			"playing": "▶",
			"paused": "⏸"
		}
	},

	"custom/power": {
		"format": "⏻",
		"tooltip": false,
		"menu": "on-click",
		"menu-file": "$HOME/.config/waybar/power_menu.xml",
		"menu-actions": {
			"suspend": "loginctl suspend",
			"hibernate": "loginctl hibernate",
			"reboot": "loginctl reboot",
			"poweroff": "loginctl poweroff"
		}
	}
}
