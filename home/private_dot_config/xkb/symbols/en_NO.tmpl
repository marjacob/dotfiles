{{- /* vim: set ft=xkb: */ -}}

default partial alphanumeric_keys

xkb_symbols "en_NO" {
    include "us(basic)"

    name[Group1]="US (Norway)";

    // Use LALT-' as æ, LALT-; as ø, and LALT-[ as 'å'.
    key <AC10> { [ semicolon,   colon,     oslash, Ooblique ] };
    key <AC11> { [ apostrophe,  quotedbl,  ae,     AE       ] };
    key <AD11> { [ bracketleft, braceleft, aring,  Aring    ] };

    // Use LALT-[hjkl] as arrow keys.
    key <AC06> { [ h, H, Left,  Left  ] };
    key <AC07> { [ j, J, Down,  Down  ] };
    key <AC08> { [ k, K, Up,    Up    ] };
    key <AC09> { [ l, L, Right, Right ] };

    // Use Caps Lock as a Control key.
    include "ctrl(nocaps)"

    // Access 3rd level with LALT.
    include "level3(lalt_switch)"

    // Use RALT as a normal LALT.
    include "level3(ralt_alt)"
};
