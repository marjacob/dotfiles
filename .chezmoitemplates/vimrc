""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
" Internal helper functions.

function! GetEncoding() abort
  return &fileencoding ? &fileencoding : &encoding
endfunction

function! GetFont() abort
{{- $font := print .font.name ":h" .font.size }}
  if has('mac')
    return '{{ $font }},Monaco:h{{- .font.size -}}'
  elseif has('win32')
    return '{{ $font }},Consolas:h{{- .font.size -}}'
  else
    return '{{ $font }},Monospace Medium:h{{- .font.size -}}'
  endif
endfunction

function! GetMode() abort
  let l:mode = {
        \ "\<C-s>": 'S-BLOCK',
        \ "\<C-v>": 'V-BLOCK',
        \ 'R': 'REPLACE',
        \ 'S': 'S-LINE',
        \ 'V': 'V-LINE',
        \ 'c': 'COMMAND',
        \ 'i': 'INSERT',
        \ 'n': 'NORMAL',
        \ 's': 'SELECT',
        \ 't': 'TERMINAL',
        \ 'v': 'VISUAL',
        \ }
  return get(l:mode, mode(), mode())
endfunction

function! StripTrailingWhitespace() abort
  let l:view = winsaveview()
  keeppatterns %s/\s\+$//e
  call winrestview(l:view)
endfunction

""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
" Ensure a consistent look and feel across CUI and GUI modes.

if has('gui_running')
  set columns={{ .editor.size.x }}
  set lines={{ .editor.size.y }}

  set guioptions+=a
  set guioptions+=c
  set guioptions-=L
  set guioptions-=R
  set guioptions-=T
  set guioptions-=b
  set guioptions-=e
  set guioptions-=f
  set guioptions-=l
  set guioptions-=m
  set guioptions-=r

  " Set list of fonts in order of preference.
  let &g:guifont=substitute(&g:guifont, '^$', GetFont(), '')

  if has('win32')
    set linespace=0
    if has('directx')
      set renderoptions=type:directx
    endif
  endif

  highlight Normal guibg=Black guifg=White
else
  highlight Normal ctermbg=Black ctermfg=White
endif

""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
" Refer to :highlight for a list of available colors.
" Select colors that look good with both :set bg=dark and :set bg=light.

highlight! link StatusLine   Question
highlight! link StatusLineNC Title

