set clipboard^=unnamed,unnamedplus                         " system clipboard
set colorcolumn=+1                                         " highlight next
set complete-=i                                            "
set display+=lastline                                      "
set display+=truncate                                      "
set fileformat=unix                                        " use lf
set fillchars+=vert:\ "                                    " no separators
set formatoptions+=jro                                     " use smart comments
set hidden                                                 " use hidden buffers
set history=1000                                           " max command history
set hlsearch                                               "
set ignorecase                                             " ignore pattern case
set incsearch                                              "
set infercase                                              " guess casing
set laststatus=2                                           " use status line
set listchars=tab:>\ ,trail:-,extends:>,precedes:<,nbsp:+  "
set mouse=a                                                " use mouse
set nofoldenable                                           "
set noshowmode                                             " no insert mode
set noswapfile                                             " no swap file
set nowrap                                                 "
set number                                                 " use line numbers
set numberwidth=5                                          " line number columns
set report=0                                               " always report
set scrolloff=1                                            " lines from cursor
set shiftwidth=0                                           " use tabstop value
set shortmess+=I                                           " no intro message
set sidescroll=1                                           "
set sidescrolloff=2                                        "
set smartcase                                              " use case for upper
set smarttab                                               " use smart tabs
