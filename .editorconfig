root = true

[*]
charset = utf-8
indent_style = tab
insert_final_newline = true
max_line_length = 80

[*.{fish,py}]
indent_size = 4
indent_style = space

[*.{json,yaml,yml}]
indent_size = 2
indent_style = space

[{*.sh,.profile,home/private_dot_local/bin/*}]
binary_next_line = true
indent_size = 2
indent_style = space
simplify = true
space_redirects = true
switch_case_indent = true
